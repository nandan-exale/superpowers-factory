#!/usr/bin/env python3
"""Show, and optionally apply, how a project's factory differs from the plugin's.

Usage: factory-update-plan <project> [--apply-safe | --resolved <path>]

Prints `<group>\t<path>` per vendored file. Groups: new, unchanged, safe,
merge, owned (factory/checks.sh, never touched), config (factory/config.json:
missing keys added, pre-0.2.0 bare model strings turned into {model, effort} keeping
the model; unchanged when that would change nothing), settings (factory/runner-settings.json:
upstream file, keeping the domains the project added; upstream's own domains are
always kept in sync with upstream, so one the project removed comes back; a settings file
the project changed beyond domains is a merge, or unchanged if upstream didn't
change it either). config and settings are unchanged when applying would not change the file.
--apply-safe copies new and safe files, merges config and settings, and
rewrites factory/manifest.json. merge files are left for the user and keep
their old manifest entry and the old vendor_hash, so the update stays pending.
--resolved <path> records that the user settled a merge file; once no merge
is left the manifest's vendor_hash becomes current. The count it prints is every
file still waiting for a record: merge rows, plus files already edited to match upstream.
"""

import copy
import json
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from factory_files import (FILES, MANIFEST, SETTINGS, manifest_data, settings_core, sha256_file,  # noqa: E402
                           vendor_dir, write_json)

OWNED = {"factory/checks.sh"}
CONFIG = "factory/config.json"


def fail(message):
    print(f"factory-update-plan: {message}", file=sys.stderr)
    sys.exit(1)


def load_json(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"{path}: {exc}")


def load_manifest(project):
    """The project's manifest as a dict, or None when missing or unreadable."""
    try:
        data = json.loads((project / MANIFEST).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) and isinstance(data.get("files"), dict) else None


def allowed_domains(data, where):
    """sandbox.network.allowedDomains of a settings file, [] when absent; refuses odd shapes."""
    sandbox = data.get("sandbox", {}) if isinstance(data, dict) else None
    network = sandbox.get("network", {}) if isinstance(sandbox, dict) else None
    domains = network.get("allowedDomains", []) if isinstance(network, dict) else None
    if not isinstance(domains, list) or not all(isinstance(d, str) for d in domains):
        fail(f"{where}: sandbox and sandbox.network must be objects and "
             "sandbox.network.allowedDomains a list of strings")
    return domains


def settings_document(mine, upstream, manifest):
    """The project's settings with upstream's domain list: upstream's domains first, then the
    domains the project added (those not in the manifest's list, or upstream's when it has none).
    A project that is still on the old core takes upstream's whole file instead."""
    mine_domains = allowed_domains(mine, SETTINGS)
    theirs = allowed_domains(upstream, f"{SETTINGS} (plugin copy)")
    base = (manifest or {}).get("settings_domains")
    if not isinstance(base, list):
        base = theirs
    wanted = theirs + [d for d in mine_domains if d not in base and d not in theirs]
    old_core = (manifest or {}).get("settings_core")
    doc = copy.deepcopy(upstream if old_core and settings_core(mine) == old_core else mine)
    doc.setdefault("sandbox", {}).setdefault("network", {})["allowedDomains"] = wanted
    return doc


def classify_settings(project, vendor, manifest):
    mine, theirs = load_json(project / SETTINGS), load_json(vendor / SETTINGS)
    mine_core, theirs_core = settings_core(mine), settings_core(theirs)
    base = (manifest or {}).get("settings_core")
    if mine_core == theirs_core or mine_core == base:
        return "settings" if settings_document(mine, theirs, manifest) != mine else "unchanged"
    if base is None:
        return "merge"
    if theirs_core != base:
        return "merge"
    # The project customized the file and upstream's core is as installed: only domains can change.
    return "settings" if settings_document(mine, theirs, manifest) != mine else "unchanged"


def classify(project, vendor, manifest):
    base = (manifest or {}).get("files")
    rows = []
    for rel in FILES:
        if rel in OWNED:
            rows.append(("owned", rel))
        elif not (project / rel).exists():
            rows.append(("new", rel))
        elif rel == CONFIG:
            mine = load_json(project / CONFIG)
            merged = add_missing(copy.deepcopy(mine), load_json(vendor / CONFIG))
            rows.append(("config" if merged != mine else "unchanged", rel))
        elif rel == SETTINGS:
            rows.append((classify_settings(project, vendor, manifest), rel))
        else:
            upstream, mine = sha256_file(vendor / rel), sha256_file(project / rel)
            was = (base or {}).get(rel)
            if mine == upstream:
                rows.append(("unchanged", rel))
            elif was is None:
                rows.append(("merge", rel))
            elif upstream == was:
                rows.append(("unchanged", rel))
            elif mine == was:
                rows.append(("safe", rel))
            else:
                rows.append(("merge", rel))
    return rows


def is_entry(value):
    """True for a {model, effort} setting."""
    return isinstance(value, dict) and set(value) == {"model", "effort"}


def migrate_entry(mine, upstream, aliases):
    """The project's {model, effort} for an upstream setting, or None to leave `mine` alone.
    A bare model string (the pre-0.2.0 shape) keeps its model when it is a known alias; a
    partial object keeps the keys it has."""
    if isinstance(mine, str):
        return {"model": mine if mine in aliases else upstream["model"], "effort": upstream["effort"]}
    if isinstance(mine, dict) and not is_entry(mine) and not set(mine) - {"model", "effort"}:
        return {**upstream, **mine}
    return None


def add_missing(mine, upstream, aliases=None, path="", notes=None):
    """Add upstream keys the project lacks, recursively, and bring old-shape model settings up
    to {model, effort}; never change a model the project chose. `notes` collects the dotted
    paths of keys that were added to a routing or reviewer table."""
    if aliases is None:
        aliases = upstream.get("model_aliases", [])
    for key, value in upstream.items():
        here = f"{path}.{key}" if path else key
        if key not in mine:
            mine[key] = value
            if notes is not None and path.split(".")[0] in ("routing", "surface_reviewers") and is_entry(value):
                notes.append(here)
        elif is_entry(value):
            migrated = migrate_entry(mine[key], value, aliases)
            if migrated is not None:
                mine[key] = migrated
        elif isinstance(mine[key], dict) and isinstance(value, dict):
            add_missing(mine[key], value, aliases, here, notes)
    return mine


def new_manifest(vendor, rows, old):
    """The manifest after an update. A `merge` file keeps its old entry (none if it had none) and
    any merge keeps the old vendor_hash, so the pending merge is still offered next session."""
    data = manifest_data(vendor)
    merges = {rel for group, rel in rows if group == "merge"}
    old = old or {}
    for rel in merges:
        if rel in old.get("files", {}):
            data["files"][rel] = old["files"][rel]
        else:
            del data["files"][rel]
    if SETTINGS in merges:
        for key in ("settings_core", "settings_domains"):
            if key in old:
                data[key] = old[key]
            else:
                del data[key]
    if merges:
        old_hash = old.get("vendor_hash")
        data["vendor_hash"] = old_hash if old_hash and old_hash != data["vendor_hash"] else "pending"
    return data


def apply_safe(project, vendor, rows, old):
    groups = dict((rel, group) for group, rel in rows)
    # Parse everything first, so a bad file applies nothing.
    config = settings = None
    if (project / SETTINGS).exists():
        allowed_domains(load_json(project / SETTINGS), SETTINGS)
        allowed_domains(load_json(vendor / SETTINGS), f"{SETTINGS} (plugin copy)")
    notes = []
    if groups.get(CONFIG) == "config":
        config = add_missing(load_json(project / CONFIG), load_json(vendor / CONFIG), notes=notes)
    if groups.get(SETTINGS) == "settings":
        settings = settings_document(load_json(project / SETTINGS), load_json(vendor / SETTINGS), old)
    for group, rel in rows:
        src, dst = vendor / rel, project / rel
        if group in ("new", "safe"):
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            if rel.startswith("factory/bin/"):
                dst.chmod(0o755)
    if config is not None and config != load_json(project / CONFIG):
        write_json(project / CONFIG, config, indent=indent_of(project / CONFIG))
        if notes:
            print("config: added with upstream defaults (edit factory/config.json to change): " + ", ".join(notes))
    if settings is not None and settings != load_json(project / SETTINGS):
        write_json(project / SETTINGS, settings)
    write_json(project / MANIFEST, new_manifest(vendor, rows, old))


def indent_of(path):
    """The indent of an existing JSON file: a tab, or the width of its first indented line; 2 otherwise."""
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        body = line.lstrip(" \t")
        if body and body != line and not body.startswith(("}", "]")):
            lead = line[:len(line) - len(body)]
            return "\t" if lead[0] == "\t" else len(lead)
    return 2


def pending(rel, manifest, vendor):
    """True when the manifest hasn't yet recorded the plugin's current version of `rel`."""
    if rel == SETTINGS:
        return (manifest or {}).get("settings_core") != settings_core(load_json(vendor / rel))
    return (manifest or {}).get("files", {}).get(rel) != sha256_file(vendor / rel)


def resolve(project, vendor, rel):
    """Record that the project's copy of `rel` is settled against the plugin's current one."""
    if rel not in FILES:
        fail(f"{rel} is not a vendored factory file")
    old = load_manifest(project)
    group = dict((r, g) for g, r in classify(project, vendor, old)).get(rel)
    if group in ("new", "safe"):
        fail(f"{rel} has an update that isn't applied yet; run --apply-safe first")
    if not pending(rel, old, vendor):
        fail(f"{rel} is not a pending merge; nothing to resolve")
    data = dict(old or {})
    data["files"] = dict(data.get("files", {}))
    data["files"][rel] = sha256_file(vendor / rel)
    if rel == SETTINGS:
        mine, theirs = load_json(project / SETTINGS), load_json(vendor / SETTINGS)
        doc = settings_document(mine, theirs, old)  # against the old base, before it is replaced
        if doc != mine:
            write_json(project / SETTINGS, doc)
        data["settings_core"] = settings_core(theirs)
        data["settings_domains"] = allowed_domains(theirs, SETTINGS)
    remaining = [r for group, r in classify(project, vendor, data)
                 if group == "merge" or (group == "unchanged" and r not in OWNED | {CONFIG}
                                         and pending(r, data, vendor))]
    current = manifest_data(vendor)["vendor_hash"]
    if not remaining:
        data["vendor_hash"] = current
    elif data.get("vendor_hash") in (None, current):
        data["vendor_hash"] = "pending"
    write_json(project / MANIFEST, data)
    return remaining


def main(argv):
    ok = (len(argv) == 2 and argv[1] == "--apply-safe") or len(argv) == 1 \
        or (len(argv) == 3 and argv[1] == "--resolved")
    if not ok:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    project, vendor = Path(argv[0]).resolve(), vendor_dir()
    if not (project / "factory" / "bin" / "job").is_file():
        fail(f"{project} has no factory installed; run /factory-install first")
    if len(argv) == 3:
        remaining = resolve(project, vendor, argv[2])
        print(f"resolved: {argv[2]}; merges left: {len(remaining)}")
        return 0
    old = load_manifest(project)
    rows = classify(project, vendor, old)
    for group, rel in rows:
        print(f"{group}\t{rel}")
    if len(argv) == 2:
        apply_safe(project, vendor, rows, old)
        print(f"applied: new and safe files copied, config and settings merged, {MANIFEST} rewritten")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
