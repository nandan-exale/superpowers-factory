#!/usr/bin/env python3
"""Write plugin/vendor/known-hashes.json: the SHA-256 of every version each vendored factory file has had.

/factory-update uses it to recognise an unedited old copy in a project whose manifest
has no entry for a file.

Usage: scripts/known-hashes [--root DIR] [--check]
  --check  don't write; exit 1 if a current vendored file's hash is missing from the list
"""

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "plugin" / "bin"))

from factory_files import FILES, RETIRED  # noqa: E402

VENDOR = "plugin/vendor/factory"
OLD_VENDOR = ("vendor/factory",)  # where the factory lived before the plugin moved into plugin/
OUT = Path("plugin/vendor/known-hashes.json")


def sha(data):
    return hashlib.sha256(data).hexdigest()


def versions(root, rel):
    """Sorted hashes of every committed version of plugin/vendor/factory/<rel>, plus the working copy.

    The factory lived in vendor/factory/ until the plugin moved into plugin/, so the history is read
    at both paths. (`git log --follow` is no use here: it drops versions of files that were later
    renamed within the factory, and of files retired before the move.)"""
    hashes = set()
    for prefix in (VENDOR, *OLD_VENDOR):
        path = f"{prefix}/{rel}"
        log = subprocess.run(["git", "log", "--format=%H", "--", path], cwd=root,
                             capture_output=True, text=True, check=True)
        for commit in log.stdout.split():
            blob = subprocess.run(["git", "show", f"{commit}:{path}"], cwd=root, capture_output=True)
            if blob.returncode == 0:  # a commit that deleted the file has no blob
                hashes.add(sha(blob.stdout))
    current = root / VENDOR / rel
    if current.is_file():
        hashes.add(sha(current.read_bytes()))
    return sorted(hashes)


def generate(root):
    return {rel: versions(root, rel) for rel in sorted({*FILES, *RETIRED})}


def missing(root):
    """Problems with the list on disk: unreadable, or a current version not in it."""
    try:
        data = json.loads((root / OUT).read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return [f"{OUT}: {exc}"]
    problems = []
    for rel in sorted(FILES):
        if sha((root / VENDOR / rel).read_bytes()) not in data.get(rel, []):
            problems.append(f"{rel}: current version isn't in {OUT}; run scripts/known-hashes")
    return problems


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", type=Path, default=REPO)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--stdout", action="store_true", help="print the list instead of writing it")
    opts = parser.parse_args(argv)
    root = opts.root.resolve()
    if opts.check:
        problems = missing(root)
        for problem in problems:
            print(problem)
        return 1 if problems else 0
    text = json.dumps(generate(root), indent=2, sort_keys=True) + "\n"
    if opts.stdout:
        sys.stdout.write(text)
        return 0
    (root / OUT).write_text(text, encoding="utf-8")
    print(f"wrote {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
