#!/usr/bin/env python3
"""Check this repo's rules. Prints PASS/FAIL per check and exits 1 on any failure."""

import argparse
import ast
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
FACTORY = Path("vendor/factory/factory")
JSON_FILES = (
    ".claude/settings.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "vendor/factory/factory/config.json",
    "hooks/hooks.json",
)


def check_license(root, opts):
    problems = []
    for rel in ("LICENSE", "vendor/factory/NOTICE", "skills/agents-best-practices/LICENSE",
                "skills/agents-best-practices/SOURCE"):
        path = root / rel
        if not path.is_file() or not path.read_text(encoding="utf-8").strip():
            problems.append(f"{rel} is missing or empty")
    return problems


def check_json(root, opts):
    problems = []
    for rel in JSON_FILES:
        try:
            json.loads((root / rel).read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            problems.append(f"{rel}: {exc}")
    if problems:
        return problems
    plugin = json.loads((root / ".claude-plugin/plugin.json").read_text(encoding="utf-8"))
    market = json.loads((root / ".claude-plugin/marketplace.json").read_text(encoding="utf-8"))
    for entry in market.get("plugins", []):
        if entry.get("name") == plugin.get("name") and entry.get("version") != plugin.get("version"):
            problems.append(f"marketplace.json version {entry.get('version')} "
                            f"!= plugin.json version {plugin.get('version')}")
    return problems


def model_entries(cfg):
    """Yield (where, entry) for every {model, effort} the factory spawns with."""
    for role, entry in cfg.get("agents", {}).items():
        yield f"agents.{role}", entry
    for risk, roles in cfg.get("routing", {}).items():
        for role, entry in roles.items():
            yield f"routing.{risk}.{role}", entry
    for surface, roles in cfg.get("surface_reviewers", {}).items():
        for role, entry in roles.items():
            yield f"surface_reviewers.{surface}.{role}", entry


def check_config(root, opts):
    cfg = json.loads((root / FACTORY / "config.json").read_text(encoding="utf-8"))
    aliases = set(cfg.get("model_aliases", []))
    efforts = set(cfg.get("effort_levels", []))
    problems = []
    for where, entry in model_entries(cfg):
        if not isinstance(entry, dict):
            problems.append(f"{where}: expected an object with model and effort")
            continue
        if entry.get("model") not in aliases:
            problems.append(f"{where}: model {entry.get('model')!r} not in model_aliases")
        if entry.get("effort") not in efforts:
            problems.append(f"{where}: effort {entry.get('effort')!r} not in effort_levels")
    return problems


FRONTMATTER_GLOBS = (
    "skills/*/SKILL.md",
    "vendor/factory/.claude/skills/*/SKILL.md",
    "vendor/factory/factory/agents/*.md",
)
TOP_LEVEL_KEY = re.compile(r"^([A-Za-z_-]+):(.*)$")


def frontmatter_keys(text):
    """Top-level keys of a leading --- block, or None if there is no closed block."""
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        return None
    keys = {}
    for line in lines[1:]:
        if line == "---":
            return keys
        match = TOP_LEVEL_KEY.match(line)
        if match:
            keys[match.group(1)] = match.group(2).strip()
    return None


def check_frontmatter(root, opts):
    paths = sorted(path for pattern in FRONTMATTER_GLOBS for path in root.glob(pattern))
    if not paths:
        return ["no skill or agent files found"]
    problems = []
    for path in paths:
        rel = path.relative_to(root)
        try:
            keys = frontmatter_keys(path.read_text(encoding="utf-8-sig"))
        except (OSError, UnicodeDecodeError) as exc:
            problems.append(f"{rel}: unreadable: {exc}")
            continue
        if keys is None:
            problems.append(f"{rel}: no --- frontmatter block")
            continue
        for required in ("name", "description"):
            if not keys.get(required):
                problems.append(f"{rel}: missing {required}")
        if "model" in keys:
            problems.append(f"{rel}: sets model; models come from factory/config.json")
    return problems


def check_compile(root, opts):
    problems = []
    for name in ("job", "gate", "route", "stop-hook", "doctor", "runner"):
        path = root / FACTORY / "bin" / name
        try:
            compile(path.read_text(encoding="utf-8"), str(path), "exec")
        except (OSError, SyntaxError) as exc:
            problems.append(f"bin/{name}: {exc}")
    for rel in ("bin/factory_files.py", "bin/factory-manifest", "bin/factory-state",
                "bin/factory-update-plan", "bin/factory-uninstall-settings", "hooks/factory-session",
                "scripts/known-hashes", "scripts/release", "scripts/e2e", "scripts/eval"):
        path = root / rel
        if not path.exists():
            continue  # added by later tasks; JSON and test checks cover their absence
        try:
            compile(path.read_text(encoding="utf-8"), str(path), "exec")
        except SyntaxError as exc:
            problems.append(f"{rel}: {exc}")
    res = subprocess.run(["bash", "-n", str(root / FACTORY / "checks.sh")], capture_output=True, text=True)
    if res.returncode != 0:
        problems.append(f"checks.sh: {res.stderr.strip()}")
    return problems


def check_hashes(root, opts):
    res = subprocess.run([sys.executable, str(REPO / "scripts" / "known-hashes"), "--root", str(root), "--check"],
                         capture_output=True, text=True)
    if res.returncode == 0:
        return []
    return res.stdout.strip().splitlines() or [res.stderr.strip() or "known-hashes --check failed"]


# SHA-256 of lowercase tokens that must never appear in a tracked file
# (the removed upstream branding). Hashed so this file doesn't name them.
FORBIDDEN_HASHES = frozenset({
    "5d4b73fc5f7b579c7b5cb3f03d7447df768e8986966bfd491f24605b45826ddb",
    "7061401397abcf81551a89f973b8b519250a7e375304eaaf6add87168ada0de3",
})
TOKEN = re.compile(r"[a-z0-9]+")


def tracked_files(root):
    res = subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"git ls-files failed: {res.stderr.strip()}")
    return [rel for rel in res.stdout.split("\0") if rel]


def check_branding(root, opts):
    forbidden = FORBIDDEN_HASHES | set(opts.extra_forbidden_hash)
    problems = []
    for rel in tracked_files(root):
        path = root / rel
        if not path.is_file():
            continue
        text = path.read_bytes().decode("utf-8", errors="ignore").lower()
        if any(hashlib.sha256(token.encode()).hexdigest() in forbidden for token in set(TOKEN.findall(text))):
            problems.append(f"{rel}: contains a forbidden upstream name")
    return problems


# Tools every machine running the factory has; any other tool the factory spawns needs a which() guard.
BASELINE_BINARIES = frozenset({"git", "bash", "python3"})
SPAWNERS = frozenset({"run", "Popen", "check_output", "check_call", "call"})
PYTHON_SHEBANG = "#!/usr/bin/env python"


def scanned_python_files(root):
    bin_dir = root / FACTORY / "bin"
    files = []
    if bin_dir.is_dir():
        for path in sorted(bin_dir.iterdir()):
            if not path.is_file():
                continue
            if path.suffix == ".py" or path.read_text(encoding="utf-8", errors="replace").startswith(PYTHON_SHEBANG):
                files.append(path)
    lib_dir = root / FACTORY / "lib"
    if lib_dir.is_dir():
        files.extend(sorted(lib_dir.rglob("*.py")))
    return files


def is_attr_call(node, names):
    return isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in names


def literal_head(call):
    """The string literal a spawn's argv list starts with, or None when it isn't one."""
    if not call.args or not isinstance(call.args[0], (ast.List, ast.Tuple)) or not call.args[0].elts:
        return None
    head = call.args[0].elts[0]
    return head.value if isinstance(head, ast.Constant) and isinstance(head.value, str) else None


def has_popen(path):
    tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
    return any(is_attr_call(node, {"Popen"}) and isinstance(node.func.value, ast.Name)
               and node.func.value.id == "subprocess" for node in ast.walk(tree))


def check_external_binaries(root, opts):
    problems = []
    for path in scanned_python_files(root):
        rel = path.relative_to(root)
        tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
        calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call)]
        guarded = {call.args[0].value for call in calls
                   if is_attr_call(call, {"which"}) and call.args
                   and isinstance(call.args[0], ast.Constant) and isinstance(call.args[0].value, str)}
        for call in calls:
            if not (is_attr_call(call, SPAWNERS) and isinstance(call.func.value, ast.Name)
                    and call.func.value.id == "subprocess"):
                continue
            name = literal_head(call)
            if name is None or name in BASELINE_BINARIES or name in guarded:
                continue
            problems.append(f"{rel}:{call.lineno}: {name!r} is spawned without shutil.which({name!r}) in the file; "
                            "a missing tool must degrade (doctor: WARN; runner/orchestrate: die(...)), "
                            "not raise a FileNotFoundError traceback")
    orchestrate = root / FACTORY / "bin" / "orchestrate"
    orchestrator = root / FACTORY / "lib" / "orchestrator"
    if orchestrate.is_file() and orchestrator.is_dir() and any(has_popen(p) for p in sorted(orchestrator.rglob("*.py"))):
        if "shutil.which" not in orchestrate.read_text(encoding="utf-8"):
            problems.append("orchestrate must check shutil.which(<adapter BINARY>) and exit non-zero before "
                            "building the Loop; a missing runtime CLI otherwise escalates every job.")
    return problems


def check_tests(root, opts):
    res = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"],
                         cwd=root, capture_output=True, text=True)
    if res.returncode == 0:
        return []
    return ["unit tests failed; last lines of output:"] + res.stderr.strip().splitlines()[-15:]


CHECKS = [
    ("license", check_license),
    ("json", check_json),
    ("config", check_config),
    ("frontmatter", check_frontmatter),
    ("compile", check_compile),
    ("hashes", check_hashes),
    ("branding", check_branding),
    ("external-binaries", check_external_binaries),
    ("tests", check_tests),
]


def run(root, opts):
    failed = False
    for name, check in CHECKS:
        if opts.fast and name == "tests":
            continue
        try:
            problems = check(root, opts)
        except Exception as exc:  # reported as a FAIL so one broken check can't hide the rest
            problems = [f"{type(exc).__name__}: {exc}"]
        if problems:
            failed = True
            for problem in problems:
                print(f"FAIL {name}: {problem}")
        else:
            print(f"PASS {name}")
    return 1 if failed else 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=REPO, help="repo to check (default: this repo)")
    parser.add_argument("--fast", action="store_true", help="skip the unit tests")
    parser.add_argument("--extra-forbidden-hash", action="append", default=[], metavar="SHA256",
                        help="add a SHA-256 to the branding check's forbidden set (for tests)")
    opts = parser.parse_args(argv)
    return run(opts.root.resolve(), opts)


if __name__ == "__main__":
    sys.exit(main())
