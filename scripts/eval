#!/usr/bin/env python3
"""Run factory agent prompts against fixtures with real agent CLI calls (the factory's runtime adapters)
and compare each case's pass rate with tests/evals/baseline.json.

Usage: scripts/eval [--agent NAME] [--samples 3] [--max-usd 5] [--update-baseline]
                    [--runtime NAME --tier fast=<model> ... [--max-runs N]]

Spends real money: run it by hand, never in CI. A case fails the run when its pass rate is more
than one sample below its baseline. --update-baseline writes the new rates for a human to review;
the baseline is Claude's, so it needs --runtime claude. A runtime that reports no cost is capped by
--max-runs (default: samples x cases) instead of --max-usd.
"""

import argparse
import copy
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from fnmatch import fnmatch
from pathlib import Path

PLUGIN = Path(__file__).resolve().parents[1]
VENDOR = PLUGIN / "vendor" / "factory"
sys.path.insert(0, str(VENDOR / "factory" / "lib"))
import runtimes  # noqa: E402
from orchestrator import agents  # noqa: E402

AGENTS = VENDOR / "factory" / "agents"
CONFIG = VENDOR / "factory" / "config.json"
SETTINGS = VENDOR / "factory" / "runner-settings.json"
TIERS = ("fast", "balanced", "strong", "frontier")
CLAUDE_EFFORTS = ("low", "medium", "high", "xhigh", "max")
EVALS = PLUGIN / "tests" / "evals"
BASELINE = EVALS / "baseline.json"
CHECK_KEYS = {"first_line", "verdict", "tags_any", "regex"}
EXPECT_KEYS = CHECK_KEYS | {"output"}
NUMBERED = re.compile(r"\s*\d+\.\s+(.*)")
TAG = re.compile(r"\[([^\]\s]+)\]")
SAMPLE_SECONDS = 900


class Stop(Exception):
    """The evals can't run at all (exit 2)."""


def agent_prompt(agent):
    """(the agent's prompt without its frontmatter, its access) from the vendored agent file."""
    path = AGENTS / f"{agent}.md"
    if not path.is_file():
        raise Stop(f"no agent {agent!r} in {AGENTS.relative_to(PLUGIN)}")
    try:
        agent_file = agents.load(VENDOR, agent)
    except ValueError as exc:
        raise Stop(str(exc))
    return agent_file["body"], agent_file["access"]


def with_tiers(cfg, runtime, tiers):
    """A copy of cfg whose runtimes.<runtime>.tiers has the --tier models."""
    out = copy.deepcopy(cfg)
    out["runtimes"][runtime]["tiers"] = {**out["runtimes"][runtime].get("tiers", {}), **tiers}
    return out


def model_for(agent, cfg, runtime="claude"):
    """{model, effort} the factory gives `agent` on a medium-risk job, resolved as `job agent` does: the
    tier's model for the runtime, and the effort or the nearest lower one it supports ("none" without any)."""
    setting = setting_for(agent, cfg)
    conf = cfg["runtimes"][runtime]
    efforts, want = conf.get("efforts") or [], setting["effort"]
    if not efforts:
        effort = "none"
    elif want in efforts:
        effort = want
    else:
        lower = [e for e in CLAUDE_EFFORTS[:CLAUDE_EFFORTS.index(want)] if e in efforts]
        effort = lower[-1] if lower else efforts[0]
    return {"model": conf["tiers"][setting["tier"]], "effort": effort}


def setting_for(agent, cfg):
    if agent in cfg.get("agents", {}):
        return cfg["agents"][agent]
    role = agent.removeprefix("reviewer-")
    medium = cfg.get("routing", {}).get("medium", {})
    if role in medium:
        return medium[role]
    for roles in cfg.get("surface_reviewers", {}).values():
        if role in roles:
            return roles[role]
    raise Stop(f"factory/config.json has no model for {agent}")


def finding_tags(text):
    tags, inside = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            inside = line[3:].strip() == "Findings"
            continue
        m = NUMBERED.fullmatch(line) if inside else None
        tag = TAG.match(m.group(1)) if m else None
        if tag:
            tags.append(tag.group(1))
    return tags


def check(expect, output):
    """Failure messages for one sample's output; empty when it passes."""
    first = next((line.strip() for line in output.splitlines() if line.strip()), "")
    fails = []
    if "first_line" in expect and first != expect["first_line"]:
        fails.append(f"first line {first!r}, expected {expect['first_line']!r}")
    if "verdict" in expect and first != f"VERDICT: {expect['verdict']}":
        fails.append(f"first line {first!r}, expected 'VERDICT: {expect['verdict']}'")
    tags = finding_tags(output)
    if "tags_any" in expect and not any(fnmatch(t, p) for t in tags for p in expect["tags_any"]):
        fails.append(f"findings tagged {tags}, expected one of {expect['tags_any']}")
    if "regex" in expect and not re.search(expect["regex"], output, re.M):
        fails.append(f"output doesn't match {expect['regex']!r}")
    return fails


def validate_case(case_dir):
    problems = [] if (case_dir / "input.md").is_file() else ["missing input.md"]
    try:
        expect = json.loads((case_dir / "expect.json").read_text())
    except (OSError, ValueError) as exc:
        return problems + [f"expect.json: {exc}"]
    problems += [f"unknown expect key {k!r}" for k in sorted(set(expect) - EXPECT_KEYS)]
    if "output" not in expect:
        problems.append("expect.json has no output (the file the agent writes)")
    if not set(expect) & CHECK_KEYS:
        problems.append(f"expect.json checks nothing (use one of {sorted(CHECK_KEYS)})")
    if "regex" in expect:
        try:
            re.compile(expect["regex"])
        except re.error as exc:
            problems.append(f"bad regex: {exc}")
    return problems


def regressions(rates, baseline, samples):
    """Cases whose pass rate is more than one sample below their baseline."""
    slack = 1 / samples + 1e-9
    return sorted(k for k, rate in rates.items() if k in baseline and rate < baseline[k] - slack)


def git(cwd, *args):
    subprocess.run(["git", "-c", "user.email=eval@example.com", "-c", "user.name=eval",
                    "-c", "commit.gpgsign=false", *args], cwd=cwd, capture_output=True, text=True, check=True)


def workspace(case_dir, root):
    """Build the case's repo in root: files/ on main, then change/ and delete.txt on factory/eval."""
    if (case_dir / "files").is_dir():
        shutil.copytree(case_dir / "files", root, dirs_exist_ok=True)
    for source, target in ((CONFIG, root / "factory" / "config.json"),
                           (SETTINGS, root / "factory" / "runner-settings.json")):
        if not target.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(source, target)
    if not (root / ".gitignore").exists():
        (root / ".gitignore").write_text("/factory/jobs/\n")
    git(root, "init", "-q", "-b", "main")
    git(root, "add", "-A")
    git(root, "commit", "-q", "-m", "base")
    change, delete = case_dir / "change", case_dir / "delete.txt"
    if change.is_dir() or delete.is_file():
        git(root, "checkout", "-q", "-b", "factory/eval")
        if change.is_dir():
            shutil.copytree(change, root, dirs_exist_ok=True)
        for rel in (delete.read_text().split() if delete.is_file() else []):
            (root / rel).unlink()
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "change")
    (root / "factory" / "jobs" / "eval" / "round-1").mkdir(parents=True, exist_ok=True)


def agent_run(root, agent, body, access, model, prompt):
    """The run dict orchestrator.loop builds, for one agent in the workspace: its files in the job's runs/."""
    runs = root / "factory" / "jobs" / "eval" / "runs"
    runs.mkdir(parents=True, exist_ok=True)
    (runs / "eval.system.md").write_text(body)
    (runs / "eval.prompt.md").write_text(prompt)
    return {"repo": root, "job_id": "eval", "role": agent, "access": access, "model": model["model"],
            "effort": model["effort"], "system_path": runs / "eval.system.md", "prompt_path": runs / "eval.prompt.md",
            "settings_dir": runs, "stem": "eval", "resume": None, "session_id": None}


def sample(case_dir, expect, agent, body, access, model, rt, budget):
    """(passed, cost, failures) for one fresh run of the case through the runtime's adapter."""
    with tempfile.TemporaryDirectory(prefix="factory-eval-") as tmp:
        root = Path(tmp).resolve()
        workspace(case_dir, root)
        prompt = (case_dir / "input.md").read_text().replace("{root}", str(root))
        run = agent_run(root, agent, body, access, model, prompt)
        argv, env = rt.build(run)
        if rt.NAME == "claude":
            argv += ["--max-budget-usd", f"{budget:.2f}", "--no-session-persistence", "--strict-mcp-config"]
        try:
            with run["prompt_path"].open() as stdin:
                res = subprocess.run(argv, cwd=root, stdin=stdin, env={**os.environ, **env},
                                     capture_output=True, text=True, timeout=SAMPLE_SECONDS)
        except subprocess.TimeoutExpired:
            return False, 0.0, [f"no answer in {SAMPLE_SECONDS}s"]
        try:
            parsed = rt.parse(res.stdout)
        except ValueError:
            return False, 0.0, [f"{argv[0]} exited {res.returncode}: {(res.stderr or res.stdout).strip()[:300]}"]
        cost = parsed["cost_usd"] or 0.0
        out_file = root / expect["output"]
        if not out_file.is_file():
            return False, cost, [f"no {expect['output']} written"]
        fails = check(expect, out_file.read_text())
        return not fails, cost, fails


def load_cases(root, agent=None):
    """[(agent, case, dir)] for every tests/evals/<agent>/<case>/expect.json."""
    cases = [(d.parent.name, d.name, d) for d in sorted(p.parent for p in root.glob("*/*/expect.json"))
             if not agent or d.parent.name == agent]
    if not cases:
        raise Stop(f"no eval cases{f' for {agent}' if agent else ''} in {root}")
    problems = [f"{a}/{c}: {p}" for a, c, d in cases for p in validate_case(d)]
    if problems:
        raise Stop("; ".join(problems))
    return cases


def run_evals(cases, samples, cap, rt, cfg, max_runs):
    """({case: pass rate}, {case: cost}, spent, runs, capped). A case cut short by the cap gets no rate.
    The cap is cap dollars when the runtime reports cost, else max_runs runs."""
    rates, costs, spent, runs = {}, {}, 0.0, 0
    for agent, case, case_dir in cases:
        body, access = agent_prompt(agent)
        model = model_for(agent, cfg, rt.NAME)
        expect = json.loads((case_dir / "expect.json").read_text())
        key, passes, cost = f"{agent}/{case}", 0, 0.0
        for n in range(samples):
            if (spent >= cap) if rt.CAPS["reports_cost"] else (runs >= max_runs):
                return rates, costs, spent, runs, True
            ok, usd, fails = sample(case_dir, expect, agent, body, access, model, rt, cap - spent)
            spent, cost, passes, runs = spent + usd, cost + usd, passes + ok, runs + 1
            price = f"${usd:.2f}" if rt.CAPS["reports_cost"] else "cost n/a"
            print(f"{key} sample {n + 1}: {'pass' if ok else 'FAIL ' + '; '.join(fails)} ({price})")
        rates[key], costs[key] = round(passes / samples, 4), round(cost, 4)
    return rates, costs, spent, runs, False


def report(rates, costs, baseline, priced=True):
    def usd(value):
        return f"${value:.2f}" if priced else "cost n/a"

    lines = []
    for key in sorted(rates):
        base = f"baseline {baseline[key]:.2f}" if key in baseline else "new"
        lines.append(f"{key}: {rates[key]:.2f} ({base}) {usd(costs[key])}")
    names = sorted({key.split("/")[0] for key in rates})
    for agent in names:
        keys = [k for k in rates if k.startswith(f"{agent}/")]
        mean = sum(rates[k] for k in keys) / len(keys)
        lines.append(f"{agent}: mean pass rate {mean:.2f}, {usd(sum(costs[k] for k in keys))}")
    return "\n".join(lines)


def preflight(rt):
    if not shutil.which(rt.BINARY):
        raise Stop(f"{rt.BINARY} isn't on PATH; install the {rt.NAME} CLI")
    if rt.NAME == "claude" and subprocess.run(["claude", "auth", "status"], capture_output=True,
                                              text=True).returncode != 0:
        raise Stop("claude isn't logged in; run claude auth login")


def tier_models(runtime, tier_args):
    """{tier: model} from --tier name=model; Stop when one is malformed, or a runtime other than claude
    lacks a tier."""
    tiers = {}
    for arg in tier_args:
        tier, _, model = arg.partition("=")
        if tier not in TIERS or not model:
            raise Stop(f"--tier {arg} must be <tier>=<model>, tier one of {', '.join(TIERS)}")
        tiers[tier] = model
    missing = [t for t in TIERS if t not in tiers]
    if runtime != "claude" and missing:
        raise Stop(f"--runtime {runtime} needs --tier for {', '.join(missing)}")
    return tiers


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--agent", help="only this agent's cases (e.g. intake, reviewer-code)")
    parser.add_argument("--samples", type=int, default=3)
    parser.add_argument("--max-usd", type=float, default=5.0)
    parser.add_argument("--update-baseline", action="store_true")
    parser.add_argument("--runtime", default="claude", choices=runtimes.NAMES, help="the agent CLI to run on")
    parser.add_argument("--tier", action="append", default=[], metavar="TIER=MODEL",
                        help="the runtime's model for a tier; every tier for a runtime other than claude")
    parser.add_argument("--max-runs", type=int, help="run cap for a runtime that reports no cost "
                                                     "(default: samples x cases)")
    opts = parser.parse_args(argv)
    if opts.samples < 1 or opts.max_usd <= 0 or (opts.max_runs is not None and opts.max_runs < 1):
        print("eval: --samples and --max-runs must be at least 1 and --max-usd more than 0", file=sys.stderr)
        return 2
    try:
        if opts.update_baseline and opts.runtime != "claude":
            raise Stop("--update-baseline needs --runtime claude: tests/evals/baseline.json is Claude's")
        cfg = with_tiers(json.loads(CONFIG.read_text()), opts.runtime, tier_models(opts.runtime, opts.tier))
        rt = runtimes.load(opts.runtime)
        preflight(rt)
        cases = load_cases(EVALS, opts.agent)
        baseline = json.loads(BASELINE.read_text()) if BASELINE.exists() else {}
        max_runs = opts.max_runs or opts.samples * len(cases)
        rates, costs, spent, runs, capped = run_evals(cases, opts.samples, opts.max_usd, rt, cfg, max_runs)
    except Stop as exc:
        print(f"eval: {exc}", file=sys.stderr)
        return 2
    priced = rt.CAPS["reports_cost"]
    print(report(rates, costs, baseline, priced))
    print(f"spent ${spent:.2f} of ${opts.max_usd:.2f}" if priced else f"cost n/a ({runs} runs of {max_runs})")
    bad = regressions(rates, baseline, opts.samples)
    for key in bad:
        print(f"REGRESSION {key}: {rates[key]:.2f}, baseline {baseline[key]:.2f}")
    if capped:
        cap = "spend cap" if priced else "run cap"
        print(f"stopped: the {cap} was reached; results are partial and the baseline is unchanged")
    elif opts.update_baseline:
        BASELINE.write_text(json.dumps({**baseline, **rates}, indent=2, sort_keys=True) + "\n")
        print(f"wrote {BASELINE}; review the diff before committing it")
    return 1 if bad or capped else 0


if __name__ == "__main__":
    sys.exit(main())
