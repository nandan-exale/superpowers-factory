#!/usr/bin/env python3
"""Claude Code Stop hook: don't end a turn while factory/checks.sh fails.

Runs factory/checks.sh when the working tree has changes that haven't passed
yet. The tree state that last passed is remembered in the git dir
(factory-stop-hook.pass), so stopping again without new edits is instant.
Blocks (exit 2) once per failure and never blocks on its own breakage.

A failure also leaves factory-stop-hook.failed in the git dir, so committing
the broken edits can't skip the next run: with that marker present, checks run
even on a clean tree. A pass removes the marker. Checks that run longer than
FACTORY_STOP_HOOK_TIMEOUT seconds (default 540) are killed and don't block.
"""

import hashlib
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
CHECKS = REPO / "factory" / "checks.sh"
# Checks run project code, so they never see the runner's Claude credentials.
SECRET_ENV = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL")
STAMP_NAME = "factory-stop-hook.pass"
FAILED_NAME = "factory-stop-hook.failed"
TAIL = 80
CHUNK = 1 << 20
DEFAULT_TIMEOUT = 540


def git(*args, text=True):
    if text:
        return subprocess.run(["git", *args], cwd=REPO, capture_output=True, text=True, errors="replace")
    return subprocess.run(["git", *args], cwd=REPO, capture_output=True)


def note(message):
    print(f"stop-hook: {message}", file=sys.stderr)


def read_payload():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return {}
    return payload if isinstance(payload, dict) else {}


def tree_key():
    """Hash of HEAD, the diff against it, and every untracked, unignored file."""
    digest = hashlib.sha256()
    if git("rev-parse", "--verify", "-q", "HEAD").returncode == 0:
        base = "HEAD"
        digest.update(git("rev-parse", "HEAD").stdout.encode())
    else:
        base = git("hash-object", "-t", "tree", os.devnull).stdout.strip()
    digest.update(git("diff", base, "--binary", text=False).stdout)
    untracked = git("ls-files", "--others", "--exclude-standard", "-z").stdout.split("\0")
    for rel in sorted(filter(None, untracked)):
        digest.update(rel.encode() + b"\0")
        path = REPO / rel
        if path.is_file():
            with path.open("rb") as handle:
                while chunk := handle.read(CHUNK):
                    digest.update(chunk)
    return digest.hexdigest()


def git_file(name):
    return REPO / git("rev-parse", "--git-path", name).stdout.strip()


def checks_timeout():
    try:
        return float(os.environ.get("FACTORY_STOP_HOOK_TIMEOUT", DEFAULT_TIMEOUT))
    except ValueError:
        return float(DEFAULT_TIMEOUT)


def run_checks(timeout):
    """(exit code, output), or None if the checks timed out and were killed."""
    env = {k: v for k, v in os.environ.items() if k not in SECRET_ENV}
    proc = subprocess.Popen(["bash", str(CHECKS)], cwd=REPO, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, errors="replace",
                            start_new_session=True, env=env)
    try:
        output, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        return None
    return proc.returncode, output


def clear(path):
    path.unlink(missing_ok=True)


def main():
    payload = read_payload()
    try:
        status = git("status", "--porcelain")
    except FileNotFoundError:
        note("git not found; skipping checks")
        return 0
    if status.returncode != 0:
        note("not a git repository; skipping checks")
        return 0
    stamp = git_file(STAMP_NAME)
    failed = git_file(FAILED_NAME)
    if not status.stdout.strip() and not failed.exists():
        return 0
    if not CHECKS.is_file():
        note("factory/checks.sh not found; skipping checks")
        return 0
    if stamp.is_file() and stamp.read_text().strip() == tree_key():
        clear(failed)
        return 0
    timeout = checks_timeout()
    try:
        result = run_checks(timeout)
    except OSError as exc:
        note(f"could not run factory/checks.sh: {exc}")
        return 0
    if result is None:
        note(f"factory/checks.sh took over {timeout:g} s; not blocking")
        return 0
    code, output = result
    if code == 0:
        # Key the tree as checks left it, so files they write can't defeat the cache.
        stamp.write_text(tree_key() + "\n")
        clear(failed)
        return 0
    failed.write_text("failed\n")
    tail = "\n".join(output.splitlines()[-TAIL:])
    print(f"factory/checks.sh failed (exit {code}); last lines:\n{tail}", file=sys.stderr)
    if payload.get("stop_hook_active"):
        note("not blocking again; fix this before you finish")
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
